# CampusConnect deployment configuration.
# Never commit real secrets. Copy this file to .env for local use only,
# or set these variables in your hosting provider's secret/environment store.

CAMPUSCONNECT_ENV=development
PORT=3005
CAMPUSCONNECT_HOST=127.0.0.1
CAMPUSCONNECT_DATA_DIR=./data
CAMPUSCONNECT_PUBLIC_URL=http://localhost:3005
CAMPUSCONNECT_HTTPS=0

# Demo seed data. Set to 0 in production.
CAMPUSCONNECT_SEED_DEMO=1

# Production bootstrap admin (required when SEED_DEMO=0 and no admin exists).
CAMPUSCONNECT_PRIMARY_ADMIN=ADMIN001
CAMPUSCONNECT_BOOTSTRAP_ADMIN_NAME=Campus Connect Admin
CAMPUSCONNECT_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
CAMPUSCONNECT_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
CAMPUSCONNECT_BOOTSTRAP_ADMIN_MOBILE=0000000000

# Gmail OTP SMTP configuration.
CAMPUSCONNECT_EMAIL_MODE=smtp
CAMPUSCONNECT_SMTP_HOST=smtp.gmail.com
CAMPUSCONNECT_SMTP_PORT=587
CAMPUSCONNECT_SMTP_USERNAME=your-sender@gmail.com
CAMPUSCONNECT_SMTP_APP_PASSWORD=your-16-character-google-app-password
CAMPUSCONNECT_SMTP_FROM_NAME=Campus Connect

# Local test transport only; never use test mode in production.
# CAMPUSCONNECT_EMAIL_MODE=test

# For local demo setup on Windows, run setup_demo_env.ps1. It creates .env.local,
# which is ignored by Git. Never commit real Gmail credentials to the repository.
