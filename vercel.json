{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/**/*.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/router?__campusconnect_route=:path*"
    },
    {
      "source": "/q/:path*",
      "destination": "/api/q/:path*"
    }
  ]
}
